# Copy to .env.local for local development. In production these come from
# GitHub → Settings → Secrets and variables → Actions (see README).

# Supabase — powers the Editor login and the guestbook. Leave empty and the
# site still works; the guestbook just shows "not configured yet".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key (spam protection on the guestbook).
VITE_TURNSTILE_SITE_KEY=

# Optional: set to true once the ask-curator Supabase function is deployed.
VITE_CURATOR_ENABLED=
